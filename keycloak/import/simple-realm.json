{
  "realm": "simple",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "browserFlow": "browser-no-otp",
  "authenticationFlows": [
    {
      "alias": "browser-no-otp",
      "description": "Browser flow without OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-no-otp-forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-no-otp-forms",
      "description": "Username and password only",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 40
    }
  ],
  "groups": [
    { "name": "admins" },
    { "name": "sales" }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "legacy-db",
        "providerId": "simple-legacy-db",
        "subComponents": {},
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "cachePolicy": ["NO_CACHE"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "test-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}