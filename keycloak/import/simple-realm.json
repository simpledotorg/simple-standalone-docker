{
  "realm": "simple",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "browserFlow": "browser-no-otp",
  "authenticationFlows": [
    {
      "alias": "browser-no-otp",
      "description": "Browser flow without OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-no-otp-forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-no-otp-forms",
      "description": "Username and password only",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 40
    }
  ],
  "roles": {
    "realm": [
      { "name": "manager" },
      { "name": "power_user" },
      { "name": "viewer_all" },
      { "name": "viewer_reports_only" }
    ]
  },
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "legacy-db",
        "providerId": "simple-legacy-db",
        "subComponents": {},
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "cachePolicy": ["NO_CACHE"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "test-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me-grafana-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3001",
      "baseUrl": "http://localhost:3001",
      "redirectUris": ["http://localhost:3001/login/generic_oauth"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}